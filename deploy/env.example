# Copy to ~/.config/swiss-content-generator/env and fill in.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# If Node isn't at /usr/bin/node, update this.
NODE_BIN=/usr/bin/node

# App
PORT=__PORT__
BIND_ADDR=__BIND_ADDR__

# Auth
AUTH_PASSWORD=change-me
AUTH_SECRET=change-me

# Database
MONGODB_URI=mongodb://oracle-vm:27017/swiss

# LLM
LLM_API_KEY=change-me
