{
  "name": "@swiss/verifier",
  "version": "1.0.0",
  "description": "Visual regression testing and layout validation for Swiss poster designs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "swiss-verify": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "tsx src/cli.ts full",
    "verify:update": "tsx src/cli.ts snapshot --update",
    "verify:layout": "tsx src/cli.ts layout",
    "verify:rules": "tsx src/cli.ts swiss-rules"
  },
  "dependencies": {
    "@swiss/primitives": "workspace:*",
    "@swiss/composer": "workspace:*",
    "@swiss/renderer": "workspace:*",
    "commander": "^12.1.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
